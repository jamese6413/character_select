using UnityEngine;
using UnityEngine.UI;
using System;
using System.Collections.Generic;
using System.Linq;

/// <summary>
/// 캐릭터를 클릭했을 때 옆에 나타나는 스킬 선택창.
/// 스킬 4개 중 정확히 2개를 골라야 확인 버튼이 활성화됩니다.
/// </summary>
public class SkillPanelUI : MonoBehaviour
{
    [Header("연결 (4개)")]
    [SerializeField] private SkillSlotUI[] skillSlots = new SkillSlotUI[4];
    [SerializeField] private Button confirmButton;

    private const int RequiredSkillCount = 2;
    private readonly List<SkillSlotUI> _selected = new List<SkillSlotUI>();

    /// <summary>확인 버튼을 눌렀을 때: 최종 선택된 스킬 2개를 전달</summary>
    public event Action<SkillData[]> OnConfirmed;

    private void Awake()
    {
        foreach (var slot in skillSlots)
            slot.OnClicked += HandleSkillClicked;

        confirmButton.onClick.AddListener(HandleConfirmClicked);
    }

    /// <summary>캐릭터를 새로 선택할 때마다 호출. 해당 캐릭터의 스킬 4개로 슬롯을 채움</summary>
    public void Setup(CharacterData character)
    {
        _selected.Clear();

        for (int i = 0; i < skillSlots.Length; i++)
        {
            var skill = i < character.skills.Length ? character.skills[i] : null;
            skillSlots[i].gameObject.SetActive(skill != null);
            if (skill != null)
            {
                skillSlots[i].Setup(skill);
                skillSlots[i].SetInteractable(true);
            }
        }

        UpdateConfirmButton();
    }

    private void HandleSkillClicked(SkillSlotUI slot)
    {
        if (slot.IsSelected)
        {
            // 선택 해제
            slot.SetSelected(false);
            _selected.Remove(slot);
        }
        else
        {
            // 이미 2개 선택된 상태면 무시 (먼저 하나를 해제해야 함)
            if (_selected.Count >= RequiredSkillCount)
                return;

            slot.SetSelected(true);
            _selected.Add(slot);
        }

        UpdateConfirmButton();
    }

    private void UpdateConfirmButton()
    {
        confirmButton.interactable = _selected.Count == RequiredSkillCount;
    }

    private void HandleConfirmClicked()
    {
        if (_selected.Count != RequiredSkillCount) return;
        OnConfirmed?.Invoke(_selected.Select(s => s.Data).ToArray());
    }

    /// <summary>패널을 특정 캐릭터 슬롯 옆(오른쪽)에 위치시킴</summary>
    public void PositionNextTo(RectTransform characterSlotRect)
    {
        var myRect = (RectTransform)transform;
        // 캐릭터 슬롯과 같은 부모 좌표계라고 가정. 다르면 anchoredPosition 계산 방식을 프로젝트에 맞게 조정하세요.
        Vector3 targetWorldPos = characterSlotRect.position;
        myRect.position = targetWorldPos + new Vector3(characterSlotRect.rect.width + 20f, 0f, 0f);
    }
}
